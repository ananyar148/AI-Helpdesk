# Database
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.ohdutpasyfbdquatncjc:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.ohdutpasyfbdquatncjc:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres"

# JWT Secret (use a long random string)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Google Gemini API Key
GEMINI_API_KEY="your-gemini-api-key-here"

# Next.js
NEXTAUTH_URL="http://localhost:3000"

# ── Email (Nodemailer) ────────────────────────────────────────────────────────
# Gmail: enable 2FA → Google Account → Security → App Passwords → generate one
# Other providers: update SMTP_HOST and SMTP_PORT accordingly
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password-here"

# Where new-ticket and resolved-ticket admin notifications go
ADMIN_EMAIL="admin@yourcompany.com"

# ── Google OAuth (for Client Portal) ─────────────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI: http://localhost:3000/api/client-auth/callback/google
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"
