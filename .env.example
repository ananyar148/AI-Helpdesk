# ── Database (Supabase) ───────────────────────────────────────────────────────
# Transaction-mode pooler (IPv4-only) — used for all queries
DATABASE_URL="postgresql://postgres.ohdutpasyfbdquatncjc:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-mode pooler — used for migrations (prisma migrate dev)
DIRECT_URL="postgresql://postgres.ohdutpasyfbdquatncjc:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres"

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT for internal team authentication (long random string)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# NextAuth (for client portal Google OAuth)
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
# In production set this to your Vercel deployment URL
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth (Client Portal) ─────────────────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI (production): https://your-app.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Google Vertex AI (AI classification) ─────────────────────────────────────
# Your Google Cloud project ID (find it in console.cloud.google.com)
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"

# Region where Vertex AI is enabled
GOOGLE_CLOUD_LOCATION="us-central1"

# Production (Vercel): paste the FULL contents of your service account JSON here as a single line
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com",...}'

# Local dev only: relative path to your service account key file
# GOOGLE_APP_CREDENTIALS="training.json"

# ── Email (Nodemailer) ────────────────────────────────────────────────────────
# Gmail: enable 2FA → Google Account → Security → App Passwords → generate one
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password-here"

# Where new-ticket and resolved-ticket admin notifications go
ADMIN_EMAIL="admin@yourcompany.com"
