// Prisma Schema — AI-powered Support Helpdesk

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Ticket ──────────────────────────────────────────────────────────────────
model Ticket {
  id            String           @id @default(cuid())
  ticketNumber  Int?             @unique
  subject       String
  description   String           @db.Text

  // AI-classified fields
  category      String           @default("Other")
  assignedTeams String[]         @default(["Support"])
  priority      String           @default("Medium")
  draftResponse String?          @db.Text

  // Classification metadata — visible to admin/team
  classificationSource  String?   // 'custom+vertex-draft' | 'vertex-ai' | 'custom-fallback' | 'cache'
  confidenceScore       Float?    // 0.0–1.0 from custom rule-based classifier

  // Workflow
  status        String           @default("Open")        // Open | In Progress | Resolved

  // Duplicate detection
  isDuplicate      Boolean  @default(false)
  duplicateOfId    String?
  similarityScore  Float?

  // Client contact
  clientEmail      String?

  // Client portal — Google-authenticated client who submitted this ticket
  clientUserId     String?
  clientUser       ClientUser?      @relation(fields: [clientUserId], references: [id], onDelete: SetNull)

  // Individual assignment — Admin assigns to a specific team member
  assignedToId     String?
  assignedTo       User?            @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Follow-up thread — links a follow-up ticket back to the original
  parentTicketId   String?

  // Relations
  activities    TicketActivity[]
  workLogs      TicketWorkLog[]
  attachments   TicketAttachment[]

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?        // soft delete — null = active, set = archived

  @@map("tickets")
}

// ─── Ticket Attachment ────────────────────────────────────────────────────────
// Images stored as base64 data URLs in the database (no external storage needed)
model TicketAttachment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  fileName   String
  mimeType   String
  dataUrl    String   @db.Text    // base64 data URL: "data:image/png;base64,..."
  sizeBytes  Int

  createdAt  DateTime @default(now())

  @@map("ticket_attachments")
}

// ─── Work Log ─────────────────────────────────────────────────────────────────
model TicketWorkLog {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId     String?
  userName   String
  userRole   String
  team       String?

  note       String   @db.Text
  visibility String   @default("Internal")

  createdAt  DateTime @default(now())

  @@map("ticket_work_logs")
}

// ─── Activity Log ─────────────────────────────────────────────────────────────
model TicketActivity {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId     String?
  userName   String?
  userRole   String?
  userTeam   String?

  action     String
  detail     String?  @db.Text
  oldValue   String?
  newValue   String?

  createdAt  DateTime @default(now())

  @@map("ticket_activities")
}

// ─── Team User (staff) ────────────────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  role      String   @default("TeamMember")
  team      String?
  isActive  Boolean  @default(false)   // false until invite is accepted

  // Invite flow
  inviteToken   String?   @unique
  inviteExpiry  DateTime?

  // Tickets individually assigned to this user
  assignedTickets Ticket[] @relation("AssignedTickets")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ─── Client User (Google OAuth + Email/Password) ─────────────────────────────
// Clients who access the portal — either via Google or email+password
model ClientUser {
  id            String    @id @default(cuid())
  googleId      String?   @unique   // Google's sub identifier (null for email/password users)
  email         String    @unique
  name          String
  picture       String?             // Google profile picture URL
  passwordHash  String?             // bcrypt hash (null for Google-only users)

  tickets       Ticket[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("client_users")
}
