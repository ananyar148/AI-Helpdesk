// Prisma Schema — AI-powered Support Helpdesk

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Ticket ──────────────────────────────────────────────────────────────────
model Ticket {
  id            String           @id @default(cuid())
  subject       String
  description   String           @db.Text

  // AI-classified fields
  category      String           @default("Other")       // Billing | Bug | Feature Request | HR | Other
  assignedTeams String[]         @default(["Support"])   // e.g. ["Development", "HR"]
  priority      String           @default("Medium")      // Low | Medium | High
  draftResponse String?          @db.Text

  // Workflow
  status        String           @default("Open")        // Open | In Progress | Resolved

  // Duplicate detection
  isDuplicate      Boolean  @default(false)
  duplicateOfId    String?
  similarityScore  Float?

  // Client contact — stored at submission for resolution emails
  clientEmail      String?

  // Relations
  activities    TicketActivity[]
  workLogs      TicketWorkLog[]

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("tickets")
}

// ─── Work Log ─────────────────────────────────────────────────────────────────
model TicketWorkLog {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId     String?
  userName   String
  userRole   String
  team       String?

  note       String   @db.Text
  visibility String   @default("Internal")    // Internal | Client

  createdAt  DateTime @default(now())

  @@map("ticket_work_logs")
}

// ─── Activity Log ─────────────────────────────────────────────────────────────
model TicketActivity {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId     String?
  userName   String?
  userRole   String?
  userTeam   String?

  action     String   // created | status_updated | priority_changed |
                      // teams_updated | ai_draft_generated | work_log_added |
                      // ticket_updated | ticket_deleted | duplicate_detected

  detail     String?  @db.Text
  oldValue   String?
  newValue   String?

  createdAt  DateTime @default(now())

  @@map("ticket_activities")
}

// ─── User ─────────────────────────────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("TeamMember")   // Admin | TeamMember
  team      String?                            // Development | Billing | HR | Support

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
