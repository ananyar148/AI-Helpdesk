// Prisma Schema — AI-powered Support Helpdesk

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Ticket ──────────────────────────────────────────────────────────────────
model Ticket {
  id            String           @id @default(cuid())
  subject       String
  description   String           @db.Text

  // AI-classified fields
  category      String           @default("Other")    // Billing | Bug | Feature Request | HR | Other
  assignedTeam  String           @default("Support")  // Development | Billing | HR | Support
  priority      String           @default("Medium")   // Low | Medium | High
  draftResponse String?          @db.Text

  // Workflow
  status        String           @default("Open")     // Open | In Progress | Resolved

  // Duplicate detection
  isDuplicate      Boolean  @default(false)
  duplicateOfId    String?                            // ID of the original ticket
  similarityScore  Float?                             // 0–1 Jaccard similarity

  // Relations
  activities    TicketActivity[]
  workLogs      TicketWorkLog[]

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("tickets")
}

// ─── Work Log ─────────────────────────────────────────────────────────────────
// Internal team notes: investigation, fixes, QA, resolution notes, etc.
// visibility = "Internal" → only team members/admins can see
// visibility = "Client"   → shown to clients as final resolution
model TicketWorkLog {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId     String?
  userName   String                            // denormalized
  userRole   String                            // Admin | TeamMember
  team       String?                           // which team added the log

  note       String   @db.Text
  visibility String   @default("Internal")    // Internal | Client

  createdAt  DateTime @default(now())

  @@map("ticket_work_logs")
}

// ─── Activity Log ─────────────────────────────────────────────────────────────
model TicketActivity {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId     String?
  userName   String?                           // e.g. "Ram"
  userRole   String?                           // Admin | TeamMember
  userTeam   String?                           // e.g. "Development" — for audit display

  action     String   // created | status_updated | priority_changed |
                      // team_reassigned | ai_draft_generated | work_log_added |
                      // ticket_updated | ticket_deleted | duplicate_detected

  detail     String?  @db.Text
  oldValue   String?
  newValue   String?

  createdAt  DateTime @default(now())

  @@map("ticket_activities")
}

// ─── User ─────────────────────────────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("TeamMember")   // Admin | TeamMember
  team      String?                            // Development | Billing | HR | Support

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
