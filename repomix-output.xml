    if (user.role === 'TeamMember' && !ticket.assignedTeams.includes(user.team)) {
      return NextResponse.json({ error: 'Access denied.' }, { status: 403 });
    }

    const activities = await prisma.ticketActivity.findMany({
      where: { ticketId: id },
      orderBy: { createdAt: 'asc' },
